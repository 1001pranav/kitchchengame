						var m := {}
						for key in v:
							m[key] = v[key].to_json()
						out[k] = m
					"o":
						out[k] = v.to_json()
					"n":
						out[k] = null if v == null else v.to_json()
			elif kind == "ss":
				var keys: Array = v.keys()
				keys.sort()
				out[k] = keys
			elif kind == "li" or kind == "ls":
				out[k] = v.duplicate()
			elif kind == "mi" or kind == "md" or kind == "ms":
				out[k] = v.duplicate()
