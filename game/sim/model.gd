						set(k, a)
					"m":
						var m := {}
						for key in (v if v != null else {}):
							m[key] = cls.new().from_json(v[key])
						set(k, m)
					"o":
						if v != null:
							set(k, cls.new().from_json(v))
					"n":
						set(k, null if v == null else cls.new().from_json(v))
				continue
			match kind:
				"i":
					set(k, int(v))
				"d":
					set(k, float(v))
				"ni":
					set(k, null if v == null else int(v))
				"li":
					set(k, (v if v != null else []).map(func(e): return int(e)))
				"ls":
					set(k, (v if v != null else []).duplicate())
				"mi":
					var m := {}
					for key in (v if v != null else {}): m[key] = int(v[key])
					set(k, m)
				"md":
					var m := {}
